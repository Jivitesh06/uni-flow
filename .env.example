VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=BCRFPJBd3uyEhTLTp3xvC_XC7xWKY5AGVtb_K-egveVehf03iaHpo1XkhOmFoimtl9uP-fhRaju5xkG1cTZePl0

# Cloud Functions base URL (for Gmail OAuth redirect)
VITE_FUNCTIONS_BASE_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net

# Google Identity Services Client ID (for Client-Side Gmail OAuth Sync on Firebase Spark Free Tier)
# Create a Web OAuth 2.0 Client ID in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Allowed college email domain (optional – enforced server-side)
VITE_ALLOWED_EMAIL_DOMAIN=college.edu

# Local Emulator Mode (set to 'true' to run 100% locally with Firebase Emulators)
VITE_USE_FIREBASE_EMULATOR=false

