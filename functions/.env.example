# Gmail OAuth Credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=https://us-central1-YOUR_PROJECT.cloudfunctions.net/gmailOAuthCallback

# App URL for redirects after OAuth
APP_URL=https://YOUR_PROJECT.web.app

# Optional: Restrict to college email domain
ALLOWED_EMAIL_DOMAIN=college.edu
